# Database. Railway gives you this as DATABASE_URL on the Postgres plugin.
DATABASE_URL=postgresql+psycopg://rolefit:rolefit@localhost:5432/rolefit

# LLM provider. Any OpenAI compatible endpoint works.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EXTRACT_MODEL=gpt-4o-mini
RERANK_MODEL=gpt-4o-mini

# Comma separated origins allowed to call the API. Lock this to your own domain.
ALLOWED_ORIGINS=http://localhost:8000

# Safety caps
MAX_RESUME_CHARS=20000
MAX_QUERY_CHARS=500
RATE_LIMIT_SEARCH=20/minute
RATE_LIMIT_MATCH=6/minute

# Ingest tuning
INGEST_CONCURRENCY=16
